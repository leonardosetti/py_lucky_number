# Lucky Number — Environment Variables
# Copy this file to .env.dev / .env.demo / .env.prod and adjust values

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-me-in-production

# API
API_HOST=0.0.0.0
API_PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://lucky:lucky@localhost:5432/lucky_dev

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Feature Toggles
FEATURE_CACHE_TTL=60

# Rate Limiting
RATE_LIMIT_GERAR=10/minute
RATE_LIMIT_ADMIN=30/minute

# Backup
BACKUP_ENCRYPTION_KEY=change-me-in-production
BACKUP_STORAGE_URL=s3://my-bucket/backups
BACKUP_INTERVAL_HOURS=24

# Collectors
COLETA_INTERVALO_MINUTOS=360
