# Lucky Number — Environment Variables
# Copy this file to .env.dev / .env.demo / .env.prod and adjust values

# Environment
ENVIRONMENT=development
LOG_LEVEL=info
SECRET_KEY=change-me-in-production  # CWE-522: must be changed in production

# API
API_HOST=0.0.0.0
API_PORT=8000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3002

# Database
DATABASE_URL=postgresql+asyncpg://lucky:lucky@localhost:5432/lucky_dev

# JWT — CWE-522: JWT_SECRET_KEY MUST be a strong random value in production
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30

# Redis
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Feature Toggles
FEATURE_CACHE_TTL=60

# Rate Limiting (CWE-307, CWE-400)
RATE_LIMIT_GERAR=10/minute      # Constitution Principle III: 10 req/min for generation
RATE_LIMIT_LOGIN=5/minute       # Max 5 login attempts per minute
RATE_LIMIT_ADMIN=30/minute
LOGIN_LOCKOUT_MINUTES=15        # Lockout duration after max failed attempts
MAX_LOGIN_ATTEMPTS=5

# Backup
BACKUP_ENCRYPTION_KEY=change-me-in-production
BACKUP_STORAGE_URL=s3://my-bucket/backups
BACKUP_INTERVAL_HOURS=24

# Collectors
COLETA_INTERVALO_MINUTOS=360

# Notifications (Email via SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@luckynumber.app
EMAIL_FROM_NAME=Lucky Number

# Notifications (WhatsApp via Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886

# Password Reset
RESET_TOKEN_TTL_MINUTES=20
MAX_RESET_ATTEMPTS=5

# Account Activation (Spec 022)
ACTIVATION_CODE_TTL_HOURS=24
MAX_ACTIVATION_ATTEMPTS=5
REGISTRATION_COOLDOWN_SECONDS=30
